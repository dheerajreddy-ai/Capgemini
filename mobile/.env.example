# ── Copy to .env and fill in. NEVER commit the real .env. ─────
# Uses EXPO_PUBLIC_* prefix — Expo exposes these to the client bundle.
# Same Firebase project as SuperFit (saifit-25ac6).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=saifit-25ac6.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=saifit-25ac6
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=saifit-25ac6.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Force mock auth in dev (no real Firebase needed). Match backend ALLOW_MOCK_AUTH.
EXPO_PUBLIC_FORCE_MOCK_AUTH=

# Backend API URL (blank = uses localhost:8000 default)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
