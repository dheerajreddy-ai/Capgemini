# Mobile config — loaded via app.config.ts / EAS secrets.
# These are CLIENT identifiers (safe to ship), not server secrets.

# Backend API
API_BASE_URL=http://localhost:8000/api/v1

# Firebase (from Firebase console → Project settings → Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# Google Sign-In (OAuth Web client ID from Google Cloud console)
GOOGLE_WEB_CLIENT_ID=
