# ── Copy to .env and fill in. NEVER commit the real .env. ─────
# Env var names are identical to SuperFit — same Railway project, same Firebase.

# App
ENV=dev                          # dev | staging | production
DEBUG=true

# Database (Railway injects DATABASE_URL automatically — paste the Railway value)
DATABASE_URL=postgresql+psycopg2://frame:frame@localhost:5432/frame

# Firebase — same project as SuperFit (saifit-25ac6)
FIREBASE_PROJECT_ID=saifit-25ac6
# Paste the entire service-account JSON as ONE value (Railway handles escaping)
FIREBASE_SERVICE_ACCOUNT=

# Mock auth — set to true in dev/test only. NEVER set in production.
ALLOW_MOCK_AUTH=false

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006

# Rate limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Gemini AI — Phase 2 (leave blank to use demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Observability
SENTRY_DSN=

# Cloudflare R2 — Phase 3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
ASSET_CDN_BASE=
ASSET_SIGNED_URL_TTL_SECONDS=3600
