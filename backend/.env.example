# ── Copy to .env and fill in. NEVER commit the real .env. ─────

# App
APP_NAME="FRAME API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# Database (Railway injects DATABASE_URL automatically in prod)
DATABASE_URL=postgresql+psycopg://frame:frame@localhost:5432/frame

# Firebase service account (paste the full JSON on ONE line, single-quoted)
FIREBASE_CREDENTIALS_JSON=''
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS — comma-separated origins (your mobile API host / web dashboard).
# Leave empty in local dev; set explicitly in production. Do NOT use "*" in prod.
CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
